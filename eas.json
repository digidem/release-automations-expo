{
	"cli": {
		"version": ">= 14.5.0",
		"appVersionSource": "remote",
		"requireCommit": true
	},
	"build": {
		"base": {
			"android": {
				"image": "latest",
				"node": "24.13.0"
			},
			"ios": {
				"image": "macos-tahoe-26.5-xcode-26.6",
				"node": "24.13.0"
			}
		},
		"development": {
			"extends": "base",
			"developmentClient": true,
			"distribution": "internal",
			"env": {
				"APP_VARIANT": "development"
			}
		},
		"release-candidate": {
			"extends": "base",
			"distribution": "internal",
			"env": {
				"APP_VARIANT": "releaseCandidate"
			}
		},
		"production": {
			"extends": "base",
			"autoIncrement": true,
			"env": {
				"APP_VARIANT": "production"
			}
		},
		"production-apk": {
			"extends": "production",
			"android": {
				"buildType": "apk"
			}
		}
	},
	"submit": {
		"production": {
			"ios": {
				"ascAppId": "6798349425"
			}
		}
	}
}
